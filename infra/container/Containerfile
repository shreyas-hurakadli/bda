FROM docker.io/library/eclipse-temurin:8-jdk

ARG HADOOP_VERSION=3.3.6
ARG SPARK_VERSION=3.5.1
ARG HIVE_VERSION=3.1.3

ENV HADOOP_HOME=/opt/hadoop \
    SPARK_HOME=/opt/spark \
    HIVE_HOME=/opt/hive \
    HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop \
    HIVE_CONF_DIR=/opt/hive/conf \
    PATH=/opt/hadoop/bin:/opt/hadoop/sbin:/opt/spark/bin:/opt/hive/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash curl procps tar \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fL --progress-bar \
      "https://archive.apache.org/dist/hadoop/common/hadoop-${HADOOP_VERSION}/hadoop-${HADOOP_VERSION}.tar.gz" \
      -o /tmp/hadoop.tgz \
    && tar -xzf /tmp/hadoop.tgz -C /opt \
    && mv "/opt/hadoop-${HADOOP_VERSION}" "${HADOOP_HOME}" \
    && rm /tmp/hadoop.tgz

RUN curl -fL --progress-bar \
      "https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop3.tgz" \
      -o /tmp/spark.tgz \
    && tar -xzf /tmp/spark.tgz -C /opt \
    && mv "/opt/spark-${SPARK_VERSION}-bin-hadoop3" "${SPARK_HOME}" \
    && rm /tmp/spark.tgz

RUN curl -fL --progress-bar \
      "https://archive.apache.org/dist/hive/hive-${HIVE_VERSION}/apache-hive-${HIVE_VERSION}-bin.tar.gz" \
      -o /tmp/hive.tgz \
    && tar -xzf /tmp/hive.tgz -C /opt \
    && mv "/opt/apache-hive-${HIVE_VERSION}-bin" "${HIVE_HOME}" \
    && rm /tmp/hive.tgz \
    && rm -f "${HIVE_HOME}"/lib/guava-*.jar \
    && cp "${HADOOP_HOME}"/share/hadoop/common/lib/guava-*.jar "${HIVE_HOME}/lib/"

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*

COPY infra/container/hadoop/ "${HADOOP_CONF_DIR}/"
COPY infra/container/hive/ "${HIVE_CONF_DIR}/"
COPY infra/container/run-demo.sh /usr/local/bin/student-warning-run-demo

WORKDIR /workspace

CMD ["bash"]
